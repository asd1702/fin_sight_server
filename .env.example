# FinSight Server 환경 변수 예시 파일 (.env.example)
# 이 파일은 템플릿입니다. 실제 민감한 값은 비워두고, 로컬에선 .env로 복사해 사용하세요.
# 운영 환경(CI/CD)에서는 시크릿 매니저/환경변수로 주입하세요.

# --- 데이터베이스 ---
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME

# --- 외부 API 키 ---
# OpenAI (LLM)
OPENAI_API_KEY=
# 네이버 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 한국은행 ECOS API
ECOS_API_KEY=
# (선택) NewsData 등 기타 제공자
NEWS_DATA_API_KEY=

# --- 애플리케이션 설정 ---
DEBUG=true
LOG_LEVEL=INFO

# --- (선택) 캐시/백엔드 서비스 ---
REDIS_URL=

# --- 관리자 엔드포인트 ---
# /api/articles/admin/* 엔드포인트 접근에 필요
ADMIN_API_KEY=
# 로컬 개발 전용: 1/true 로 설정 시 관리자 인증 우회(운영 금지)
UNSAFE_ADMIN_MODE=0

# --- 파이프라인/LLM 설정 (자세한 내용은 app/core/config.py 참고) ---
BATCH_SIZE=
MAX_WORKERS=
RETRY_ATTEMPTS=
LLM_MODEL=gpt-4o-mini
MAX_TOKENS=
TEMPERATURE=0.3

# --- 레터 파이프라인 기본값 ---
LETTER_TTL_HOURS=24
LETTER_MAX_CRAWL_ATTEMPTS=2
LETTER_MAX_LLM_ATTEMPTS=2
LETTER_MIN_CONTENT_LEN=200
LETTER_MIN_ARTICLES=3
LETTER_LLM_MODEL=gpt-4o-mini
LETTER_CACHE_MAX_AGE_DAYS=14

# --- ECOS 수집 ---
ECOS_PAGE_SIZE=1000
ECOS_RECHECK_DAYS=7
ECOS_INITIAL_DATE=2000-01-01
